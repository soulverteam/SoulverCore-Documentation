{"hierarchy":{"paths":[["doc:\/\/app.soulver.core\/documentation\/SoulverCore","doc:\/\/app.soulver.core\/documentation\/SoulverCore\/EngineFeatureFlags"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/soulvercore\/enginefeatureflags\/properfractionparsing"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/EngineFeatureFlags\/properFractionParsing"},"kind":"symbol","metadata":{"modules":[{"name":"SoulverCore"}],"externalID":"s:11SoulverCore18EngineFeatureFlagsV21properFractionParsingSbvp","role":"symbol","roleHeading":"Instance Property","title":"properFractionParsing","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"properFractionParsing","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"symbolKind":"property"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Recognise “score-shaped” fractions so they survive evaluation as "},{"code":"EvaluationResult.fraction","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"rather than being collapsed to a decimal."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"properFractionParsing","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"With this flag on:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"4\/10","type":"codeVoice"},{"type":"text","text":", "},{"code":"4.5\/10","type":"codeVoice"},{"type":"text","text":", "},{"code":"4 km \/ 10 km","type":"codeVoice"},{"type":"text","text":", "},{"code":"$10 out of $50","type":"codeVoice"},{"type":"text","text":" evaluate as "},{"code":"Fraction","type":"codeVoice"},{"type":"text","text":" (with "},{"code":"preferredDenominator","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"set to the literal denominator and "},{"code":"unitValue","type":"codeVoice"},{"type":"text","text":" set when both sides share the same "},{"code":"SCUnit","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The "},{"code":"out of","type":"codeVoice"},{"type":"text","text":" word function ("},{"code":"FunctionIdentifier.properFractionForming","type":"codeVoice"},{"type":"text","text":") is enabled, producing the"},{"type":"text","text":" "},{"type":"text","text":"same "},{"code":"Fraction","type":"codeVoice"},{"type":"text","text":" shape as the numeric form."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The numeric form only fires when the whole expression is a single ratio, both sides are non-negative,"},{"type":"text","text":" "},{"type":"text","text":"the denominator is a positive integer, and "},{"type":"codeVoice","code":"numerator ≤ denominator"},{"type":"text","text":" — i.e. "},{"type":"codeVoice","code":"Fraction.isProper"},{"type":"text","text":" would"},{"type":"text","text":" "},{"type":"text","text":"return "},{"type":"codeVoice","code":"true"},{"type":"text","text":". Otherwise the line falls through to plain division."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Off by default — leaving it off preserves the historical behaviour where "},{"type":"codeVoice","code":"4\/10"},{"type":"text","text":" is "},{"type":"codeVoice","code":"0.4"},{"type":"text","text":"."}],"type":"paragraph"}]}],"references":{"doc://app.soulver.core/documentation/SoulverCore":{"kind":"symbol","title":"SoulverCore","url":"\/documentation\/soulvercore","role":"collection","identifier":"doc:\/\/app.soulver.c