{"hierarchy":{"paths":[["doc:\/\/app.soulver.core\/documentation\/SoulverCore"]]},"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser"},{"text":" lets you parse a natural language string into a ready-to-use Swift object (or graph of objects) in a single call. It handles the tokenization, type recognition, and data extraction automatically.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Unlike the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/DataPoint"},{"text":"-based ","type":"text"},{"type":"codeVoice","code":"find"},{"text":" API (which extracts individual data points from strings), ObjectParser creates complete model objects — with all their properties populated from the data in the string.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The initializer form — conform to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ParsableObject"},{"text":" and implement ","type":"text"},{"type":"codeVoice","code":"init(from parser: ObjectParser)"},{"text":", scanning out the values you need — is inspired by Swift’s ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Quick-start","text":"Quick start","level":2,"type":"heading"},{"inlineContent":[{"text":"The easiest way to parse objects is with the ","type":"text"},{"type":"codeVoice","code":"parseObject()"},{"text":" string extension, combined with types conforming to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ParsableObject"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import SoulverCore","","struct SalesRecord: ParsableObject {","    let quantity: Int","    let date: Date","","    init(from parser: ObjectParser) throws {","        self.quantity = try parser.scan(.number)","        self.date = try parser.scan(.date)","    }","}","","let record: SalesRecord = try \"We sold 130 copies yesterday\".parseObject()","\/\/ record.quantity → 130","\/\/ record.date → yesterday's date"],"syntax":"swift"},{"type":"heading","text":"Using ObjectParser directly","level":2,"anchor":"Using-ObjectParser-directly"},{"inlineContent":[{"type":"text","text":"For more control, create an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser"},{"type":"text","text":" instance yourself:"}],"type":"paragraph"},{"type":"codeListing","code":["let parser = ObjectParser(\"QF 123 tomorrow\")","","let flight: Flight = try parser.parse(Flight.self)","let date: Date = try parser.scan(.date)"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Creating the parser directly is useful when:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"You want to attempt multiple parses on the same tokenized string (using ","type":"text"},{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser\/reset()","type":"reference","isActive":true},{"text":" between attempts)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"You need to check the structure of the expression before parsing","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"You want to provide a custom ","type":"text"},{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/EngineCustomization","type":"reference","isActive":true}]}]}]},{"type":"heading","level":2,"text":"Scanning data points","anchor":"Scanning-data-points"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inside a "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ParsableObject","isActive":true},{"type":"text","text":" initializer, you use "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser\/scan(_:)","isActive":true},{"type":"text","text":" and "},{"type":"codeVoice","code":"scanIfPresent"},{"type":"text","text":" to extract individual data points from the expression:"}]},{"type":"codeListing","code":["struct Pace: ParsableObject {","    let distanceTravelled: Decimal","    let time: TimeInterval","","    init(from parser: ObjectParser) throws {","        self.time = try parser.scan(.timespan).timeIntervalValue","        self.distanceTravelled = try parser.scan(.number)","    }","","    static var orderingStrategy: OrderingStrategy { .unordered }","}","","let pace: Pace = try \"I ran 3 km in 12.5 minutes\".parseObject()","\/\/ pace.distanceTravelled → 3","\/\/ pace.time → 750.0 (seconds)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"scan"},{"type":"text","text":" throws if the data type isn’t found. "},{"type":"codeVoice","code":"scanIfPresent"},{"type":"text","text":" returns nil instead."}]},{"type":"heading","level":2,"text":"Nested objects","anchor":"Nested-objects"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"parse"},{"type":"text","text":" also handles nested "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ParsableObject","isActive":true},{"type":"text","text":" types, making object composition straightforward:"}]},{"type":"codeListing","code":["struct FlightOnDate: ParsableObject {","    let flight: Flight","    let date: Date","","    init(from parser: ObjectParser) throws {","        self.flight = try parser.parse(Flight.self)","        self.date = try parser.scan(.date)","    }","}","","let query: FlightOnDate = try \"QF123 tomorrow\".parseObject()"],"syntax":"swift"},{"type":"heading","level":2,"text":"Ordered vs unordered parsing","anchor":"Ordered-vs-unordered-parsing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default, properties are scanned in declaration order (the parser cursor advances forward through the string). Set "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/OrderingStrategy\/unordered","isActive":true},{"type":"text","text":" to allow properties to appear in any order:"}]},{"type":"codeListing","code":["struct Meeting: ParsableObject {","    let date: Date","    let attendees: Int","","    init(from parser: ObjectParser) throws {","        self.date = try parser.scan(.date)","        self.attendees = try parser.scan(.number)","    }","","    static var orderingStrategy: OrderingStrategy { .unordered }","}","","\/\/ Both of these work:","let m1: Meeting = try \"March 15 with 5 people\".parseObject()","let m2: Meeting = try \"5 people on March 15\".parseObject()"],"syntax":"swift"},{"type":"heading","level":2,"text":"Keywords","anchor":"Keywords"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To parse custom enum types from strings, conform them to "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/Keyword","isActive":true},{"type":"text","text":" and declare them as keyword types when creating the parser. Keywords are matched case-insensitively:"}]},{"type":"codeListing","code":["enum BreakfastItem: String, Keyword {","    case waffles","    case eggs","","    var aliases: [String] {","        switch self {","        case .waffles: return [\"waffle\"]","        case .eggs: return [\"egg\"]","        }","    }","}","","struct BreakfastOrder: ParsableObject {","    let quantity: Int","    let item: BreakfastItem","","    init(from parser: ObjectParser) throws {","        self.quantity = try parser.scan(.number)","        self.item = try parser.scanKeyword(ofType: BreakfastItem.self)","    }","","    static var keywordTypes: KeywordTypeList { [BreakfastItem.self] }","}","","let order: BreakfastOrder = try \"2 waffles\".parseObject()"],"syntax":"swift"},{"type":"aside","name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keyword types must be declared in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ParsableObject\/keywordTypes"},{"type":"text","text":" (or passed to the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser"},{"type":"text","text":" initializer) so the parser can recognize them during tokenization."}]}]},{"type":"heading","level":2,"text":"Checking expression structure","anchor":"Checking-expression-structure"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can inspect the expression before attempting a full parse:"}]},{"type":"codeListing","code":["let parser = ObjectParser(\"time in Sydney\")","","\/\/ Does this expression have the same structure as another?","parser.matchesStructure(of: \"time in Los Angeles\") \/\/ true","parser.matchesStructure(of: \"flights to London\")   \/\/ false","","\/\/ Are particular words present?","try parser.ensurePresent(words: [\"time\"]) \/\/ succeeds","","\/\/ Does the expression contain a particular token type?","parser.containsType(tokenType: .date)    \/\/ false","parser.containsType(tokenType: .place)   \/\/ true"],"syntax":"swift"},{"text":"Attempting multiple parses","type":"heading","anchor":"Attempting-multiple-parses","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser\/reset()","type":"reference","isActive":true},{"text":" to rewind the parser’s cursor and try parsing a different type from the same tokenized expression:","type":"text"}]},{"type":"codeListing","code":["let parser = ObjectParser(\"QF 33 to London\", keywordTypes: [Airline.self, TravelDirection.self])","","if let flight: FlightLookup = try? parser.parse(FlightLookup.self) {","    \/\/ Got a full flight lookup","} else {","    parser.reset()","    if let route: RouteLookup = try? parser.parse(RouteLookup.self) {","        \/\/ Got a route lookup instead","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This avoids re-tokenizing the string when you want to attempt multiple types against the same input.","type":"text"}]},{"text":"Performing replacements","level":2,"anchor":"Performing-replacements","type":"heading"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser","type":"reference"},{"text":" can also generate new strings by replacing matched data types:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let parser = ObjectParser(\"I scored 85 and then 92\")","","\/\/ Replace the first number","let result = parser.replacingFirst(.number) { value in","    return \"\\(value + 10)\"","}","\/\/ \"I scored 95 and then 92\"","","\/\/ Replace all numbers","let result2 = parser.replacingAll(.number) { value in","    return \"\\(value + 10)\"","}","\/\/ \"I scored 95 and then 102\""]},{"text":"Error handling","type":"heading","anchor":"Error-handling","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser","isActive":true},{"type":"text","text":" throws "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser\/ScanningError","isActive":true},{"type":"text","text":" values that include the type being parsed and the original expression, making debugging straightforward:"}]},{"syntax":"swift","type":"codeListing","code":["do {","    let _: Flight = try \"not a flight\".parseObject()","} catch {","    print(error.localizedDescription)","    \/\/ \"Failed to parse Flight from expression: 'not a flight'\"","}"]}],"kind":"content"}],"sections":[],"seeAlsoSections":[{"anchor":"Data-Parsing","title":"Data Parsing","identifiers":["doc:\/\/app.soulver.core\/documentation\/SoulverCore\/DateParsing","doc:\/\/app.soulver.core\/documentation\/SoulverCore\/DataParsing"],"generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParsing"},"abstract":[{"text":"Transform natural language strings into strongly-typed Swift objects with a single call","type":"text"}],"variants":[{"paths":["\/documentation\/soulvercore\/objectparsing"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"SoulverCore"}],"roleHeading":"Article","title":"Objects from strings","role":"article"},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","references":{"doc://app.soulver.core/documentation/SoulverCore/ParsableObject/keywordTypes":{"defaultImplementations":2,"type":"topic","title":"keywordTypes","abstract":[{"type":"text","text":"Any keyword types that you use in this object."}],"url":"\/documentation\/soulvercore\/parsableobject\/keywordtypes","kind":"symbol","role":"symbol","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ParsableObject\/keywordTypes","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"keywordTypes","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11SoulverCore15KeywordTypeLista","kind":"typeIdentifier","text":"KeywordTypeList"}],"required":true},"doc://app.soulver.core/documentation/SoulverCore/Keyword":{"type":"topic","url":"\/documentation\/soulvercore\/keyword","navigatorTitle":[{"text":"Keyword","kind":"identifier"}],"kind":"symbol","title":"Keyword","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/Keyword","role":"symbol","abstract":[{"type":"text","text":"Basically a string Enum with case