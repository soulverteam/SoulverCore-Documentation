{"hierarchy":{"paths":[["doc:\/\/app.soulver.core\/documentation\/SoulverCore"]]},"seeAlsoSections":[{"generated":true,"title":"Data Parsing","identifiers":["doc:\/\/app.soulver.core\/documentation\/SoulverCore\/DateParsing","doc:\/\/app.soulver.core\/documentation\/SoulverCore\/DataParsing"],"anchor":"Data-Parsing"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser","isActive":true},{"type":"text","text":" lets you parse a natural language string into a ready-to-use Swift object (or graph of objects) in a single call. It handles the tokenization, type recognition, and data extraction automatically."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Unlike the "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/DataPoint","isActive":true},{"type":"text","text":"-based "},{"type":"codeVoice","code":"find"},{"type":"text","text":" API (which extracts individual data points from strings), ObjectParser creates complete model objects — with all their properties populated from the data in the string."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The initializer form — conform to "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ParsableObject","isActive":true},{"type":"text","text":" and implement "},{"type":"codeVoice","code":"init(from parser: ObjectParser)"},{"type":"text","text":", scanning out the values you need — is inspired by Swift’s "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Quick-start","level":2,"text":"Quick start","type":"heading"},{"inlineContent":[{"type":"text","text":"The easiest way to parse objects is with the "},{"type":"codeVoice","code":"parseObject()"},{"type":"text","text":" string extension, combined with types conforming to "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ParsableObject","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SoulverCore","","struct SalesRecord: ParsableObject {","    let quantity: Int","    let date: Date","","    init(from parser: ObjectParser) throws {","        self.quantity = try parser.scan(.number)","        self.date = try parser.scan(.date)","    }","}","","let record: SalesRecord = try \"We sold 130 copies yesterday\".parseObject()","\/\/ record.quantity → 130","\/\/ record.date → yesterday's date"]},{"anchor":"Using-ObjectParser-directly","level":2,"text":"Using ObjectParser directly","type":"heading"},{"inlineContent":[{"type":"text","text":"For more control, create an "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser","isActive":true},{"type":"text","text":" instance yourself:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let parser = ObjectParser(\"QF 123 tomorrow\")","","let flight: Flight = try parser.parse(Flight.self)","let date: Date = try parser.scan(.date)"]},{"inlineContent":[{"type":"text","text":"Creating the parser directly is useful when:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"You want to attempt multiple parses on the same tokenized string (using ","type":"text"},{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser\/reset()","isActive":true,"type":"reference"},{"text":" between attempts)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"You need to check the structure of the expression before parsing","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"You want to provide a custom ","type":"text"},{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/EngineCustomization","isActive":true,"type":"reference"}],"type":"paragraph"}]}]},{"anchor":"Scanning-data-points","level":2,"text":"Scanning data points","type":"heading"},{"inlineContent":[{"type":"text","text":"Inside a "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ParsableObject","isActive":true},{"type":"text","text":" initializer, you use "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser\/scan(_:)","isActive":true},{"type":"text","text":" and "},{"type":"codeVoice","code":"scanIfPresent"},{"type":"text","text":" to extract individual data points from the expression:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct Pace: ParsableObject {","    let distanceTravelled: Decimal","    let time: TimeInterval","","    init(from parser: ObjectParser) throws {","        self.time = try parser.scan(.timespan).timeIntervalValue","        self.distanceTravelled = try parser.scan(.number)","    }","","    static var orderingStrategy: OrderingStrategy { .unordered }","}","","let pace: Pace = try \"I ran 3 km in 12.5 minutes\".parseObject()","\/\/ pace.distanceTravelled → 3","\/\/ pace.time → 750.0 (seconds)"]},{"inlineContent":[{"type":"codeVoice","code":"scan"},{"type":"text","text":" throws if the data type isn’t found. "},{"type":"codeVoice","code":"scanIfPresent"},{"type":"text","text":" returns nil instead."}],"type":"paragraph"},{"anchor":"Nested-objects","level":2,"text":"Nested objects","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"parse"},{"type":"text","text":" also handles nested "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ParsableObject","isActive":true},{"type":"text","text":" types, making object composition straightforward:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct FlightOnDate: ParsableObject {","    let flight: Flight","    let date: Date","","    init(from parser: ObjectParser) throws {","        self.flight = try parser.parse(Flight.self)","        self.date = try parser.scan(.date)","    }","}","","let query: FlightOnDate = try \"QF123 tomorrow\".parseObject()"]},{"anchor":"Ordered-vs-unordered-parsing","level":2,"text":"Ordered vs unordered parsing","type":"heading"},{"inlineContent":[{"type":"text","text":"By default, properties are scanned in declaration order (the parser cursor advances forward through the string). Set "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/OrderingStrategy\/unordered","isActive":true},{"type":"text","text":" to allow properties to appear in any order:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct Meeting: ParsableObject {","    let date: Date","    let attendees: Int","","    init(from parser: ObjectParser) throws {","        self.date = try parser.scan(.date)","        self.attendees = try parser.scan(.number)","    }","","    static var orderingStrategy: OrderingStrategy { .unordered }","}","","\/\/ Both of these work:","let m1: Meeting = try \"March 15 with 5 people\".parseObject()","let m2: Meeting = try \"5 people on March 15\".parseObject()"]},{"anchor":"Keywords","level":2,"text":"Keywords","type":"heading"},{"inlineContent":[{"type":"text","text":"To parse custom enum types from strings, conform them to "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/Keyword","isActive":true},{"type":"text","text":" and declare them as keyword types when creating the parser. Keywords are matched case-insensitively:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["enum BreakfastItem: String, Keyword {","    case waffles","    case eggs","","    var aliases: [String] {","        switch self {","        case .waffles: return [\"waffle\"]","        case .eggs: return [\"egg\"]","        }","    }","}","","struct BreakfastOrder: ParsableObject {","    let quantity: Int","    let item: BreakfastItem","","    init(from parser: ObjectParser) throws {","        self.quantity = try parser.scan(.number)","        self.item = try parser.scanKeyword(ofType: BreakfastItem.self)","    }","","    static var keywordTypes: KeywordTypeList { [BreakfastItem.self] }","}","","let order: BreakfastOrder = try \"2 waffles\".parseObject()"]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Keyword types must be declared in ","type":"text"},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ParsableObject\/keywordTypes","isActive":true},{"text":" (or passed to the ","type":"text"},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser","isActive":true},{"text":" initializer) so the parser can recognize them during tokenization.","type":"text"}]}],"type":"aside","style":"important","name":"Important"},{"anchor":"Checking-expression-structure","level":2,"text":"Checking expression structure","type":"heading"},{"inlineContent":[{"type":"text","text":"You can inspect the expression before attempting a full parse:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let parser = ObjectParser(\"time in Sydney\")","","\/\/ Does this expression have the same structure as another?","parser.matchesStructure(of: \"time in Los Angeles\") \/\/ true","parser.matchesStructure(of: \"flights to London\")   \/\/ false","","\/\/ Are particular words present?","try parser.ensurePresent(words: [\"time\"]) \/\/ succeeds","","\/\/ Does the expression contain a particular token type?","parser.containsType(tokenType: .date)    \/\/ false","parser.containsType(tokenType: .place)   \/\/ true"]},{"anchor":"Attempting-multiple-parses","level":2,"text":"Attempting multiple parses","type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser\/reset()","isActive":true},{"type":"text","text":" to rewind the parser’s cursor and try parsing a different type from the same tokenized expression:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let parser = ObjectParser(\"QF 33 to London\", keywordTypes: [Airline.self, TravelDirection.self])","","if let flight: FlightLookup = try? parser.parse(FlightLookup.self) {","    \/\/ Got a full flight lookup","} else {","    parser.reset()","    if let route: RouteLookup = try? parser.parse(RouteLookup.self) {","        \/\/ Got a route lookup instead","    }","}"]},{"inlineContent":[{"type":"text","text":"This avoids re-tokenizing the string when you want to attempt multiple types against the same input."}],"type":"paragraph"},{"anchor":"Performing-replacements","level":2,"text":"Performing replacements","type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser","isActive":true},{"type":"text","text":" can also generate new strings by replacing matched data types:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let parser = ObjectParser(\"I scored 85 and then 92\")","","\/\/ Replace the first number","let result = parser.replacingFirst(.number) { value in","    return \"\\(value + 10)\"","}","\/\/ \"I scored 95 and then 92\"","","\/\/ Replace all numbers","let result2 = parser.replacingAll(.number) { value in","    return \"\\(value + 10)\"","}","\/\/ \"I scored 95 and then 102\""]},{"anchor":"Error-handling","level":2,"text":"Error handling","type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser","isActive":true},{"type":"text","text":" throws "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser\/ScanningError","isActive":true},{"type":"text","text":" values that include the type being parsed and the original expression, making debugging straightforward:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["do {","    let _: Flight = try \"not a flight\".parseObject()","} catch {","    print(error.localizedDescription)","    \/\/ \"Failed to parse Flight from expression: 'not a flight'\"","}"]}]}],"metadata":{"role":"article","roleHeading":"Article","title":"Objects from strings","modules":[{"name":"SoulverCore"}]},"kind":"article","variants":[{"paths":["\/documentation\/soulvercore\/objectparsing"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Transform natural language strings into strongly-typed Swift objects with a single call","type":"text"}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParsing","interfaceLanguage":"swift"},"references":{"doc://app.soulver.core/documentation/SoulverCore/ObjectParser/scan(_:)":{"abstract":[{"text":"Scans for the next occurrence of a data type and returns the parsed value.","type":"text"}],"type":"topic","title":"scan(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"scan"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"preciseIdentifier":"s:11SoulverCore9DataPointV","kind":"typeIdentifier","text":"DataPoint"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:11SoulverCore12ObjectParserC4scany8DataTypeQzAA0F5PointVyxGKAA0f9FromTokenD0RzlF1TL_xmfp","kind":"typeIdentifier","text":"T"},{"kind":"text","text":">) "},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:11SoulverCore12ObjectParserC4scany8DataTypeQzAA0F5PointVyxGKAA0f9FromTokenD0RzlF1TL_xmfp","text":"T","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:11SoulverCore19DataFromTokenParserP0C4TypeQa","text":"DataType","kind":"typeIdentifier"}],"kind":"symbol","url":"\/documentation\/soulvercore\/objectparser\/scan(_:)","role":"symbol","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser\/scan(_:)"},"doc://app.soulver.core/documentation/SoulverCore/ParsableObject":{"abstract":[{"type":"text","text":"Adopt by an object that can be initialized from a string representation"}],"type":"topic","title":"ParsableObject","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ParsableObject","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/soulvercore\/parsableobject","role":"symbol","navigatorTitle":[{"text":"ParsableObject","kind":"identifier"}],"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ParsableObject"},"doc://app.soulver.core/documentation/SoulverCore/ObjectParser":{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser","url":"\/documentation\/soulvercore\/objectparser","kind":"symbol","abstract":[{"type":"text","text":"Transforms a natural language string into strongly-typed Swift objects."}],"type":"topic","title":"ObjectParser","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ObjectParser"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ObjectParser"}]},"doc://app.soulver.core/documentation/SoulverCore/DataPoint":{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/DataPoint","url":"\/documentation\/soulvercore\/datapoint","type":"topic","abstract":[{"type":"text","text":"Wraps a parser for this particular data type"}],"kind":"symbol","title":"DataPoint","role":"symbol","navigatorTitle":[{"text":"DataPoint","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DataPoint","kind":"identifier"}]},"doc://app.soulver.core/documentation/SoulverCore/ObjectParser/ScanningError":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScanningError"}],"navigatorTitl