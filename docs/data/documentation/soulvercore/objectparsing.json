{"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser","type":"reference"},{"text":" lets you parse a natural language string into a ready-to-use Swift object (or graph of objects) in a single call. It handles the tokenization, type recognition, and data extraction automatically.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Unlike the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/DataPoint","type":"reference"},{"text":"-based ","type":"text"},{"code":"find","type":"codeVoice"},{"text":" API (which extracts individual data points from strings), ObjectParser creates complete model objects — with all their properties populated from the data in the string.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The initializer form — conform to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ParsableObject"},{"type":"text","text":" and implement "},{"code":"init(from parser: ObjectParser)","type":"codeVoice"},{"text":", scanning out the values you need — is inspired by Swift’s ","type":"text"},{"type":"codeVoice","code":"Codable"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","text":"Quick start","level":2,"anchor":"Quick-start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The easiest way to parse objects is with the "},{"code":"parseObject()","type":"codeVoice"},{"type":"text","text":" string extension, combined with types conforming to "},{"isActive":true,"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ParsableObject","type":"reference"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["import SoulverCore","","struct SalesRecord: ParsableObject {","    let quantity: Int","    let date: Date","","    init(from parser: ObjectParser) throws {","        self.quantity = try parser.scan(.number)","        self.date = try parser.scan(.date)","    }","}","","let record: SalesRecord = try \"We sold 130 copies yesterday\".parseObject()","\/\/ record.quantity → 130","\/\/ record.date → yesterday's date"]},{"type":"heading","level":2,"text":"Using ObjectParser directly","anchor":"Using-ObjectParser-directly"},{"type":"paragraph","inlineContent":[{"text":"For more control, create an ","type":"text"},{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser","isActive":true,"type":"reference"},{"text":" instance yourself:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let parser = ObjectParser(\"QF 123 tomorrow\")","","let flight: Flight = try parser.parse(Flight.self)","let date: Date = try parser.scan(.date)"]},{"type":"paragraph","inlineContent":[{"text":"Creating the parser directly is useful when:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"You want to attempt multiple parses on the same tokenized string (using "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser\/reset()","isActive":true},{"type":"text","text":" between attempts)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"You need to check the structure of the expression before parsing","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"You want to provide a custom "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/EngineCustomization","isActive":true}],"type":"paragraph"}]}]},{"anchor":"Scanning-data-points","type":"heading","level":2,"text":"Scanning data points"},{"inlineContent":[{"type":"text","text":"Inside a "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ParsableObject","isActive":true},{"type":"text","text":" initializer, you use "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser\/scan(_:)","isActive":true},{"type":"text","text":" and "},{"type":"codeVoice","code":"scanIfPresent"},{"type":"text","text":" to extract individual data points from the expression:"}],"type":"paragraph"},{"syntax":"swift","code":["struct Pace: ParsableObject {","    let distanceTravelled: Decimal","    let time: TimeInterval","","    init(from parser: ObjectParser) throws {","        self.time = try parser.scan(.timespan).timeIntervalValue","        self.distanceTravelled = try parser.scan(.number)","    }","","    static var orderingStrategy: OrderingStrategy { .unordered }","}","","let pace: Pace = try \"I ran 3 km in 12.5 minutes\".parseObject()","\/\/ pace.distanceTravelled → 3","\/\/ pace.time → 750.0 (seconds)"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"scan"},{"type":"text","text":" throws if the data type isn’t found. "},{"type":"codeVoice","code":"scanIfPresent"},{"type":"text","text":" returns nil instead."}],"type":"paragraph"},{"anchor":"Nested-objects","type":"heading","level":2,"text":"Nested objects"},{"inlineContent":[{"type":"codeVoice","code":"parse"},{"type":"text","text":" also handles nested "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ParsableObject","isActive":true},{"type":"text","text":" types, making object composition straightforward:"}],"type":"paragraph"},{"syntax":"swift","code":["struct FlightOnDate: ParsableObject {","    let flight: Flight","    let date: Date","","    init(from parser: ObjectParser) throws {","        self.flight = try parser.parse(Flight.self)","        self.date = try parser.scan(.date)","    }","}","","let query: FlightOnDate = try \"QF123 tomorrow\".parseObject()"],"type":"codeListing"},{"anchor":"Ordered-vs-unordered-parsing","type":"heading","level":2,"text":"Ordered vs unordered parsing"},{"inlineContent":[{"type":"text","text":"By default, properties are scanned in declaration order (the parser cursor advances forward through the string). Set "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/OrderingStrategy\/unordered","isActive":true},{"type":"text","text":" to allow properties to appear in any order:"}],"type":"paragraph"},{"syntax":"swift","code":["struct Meeting: ParsableObject {","    let date: Date","    let attendees: Int","","    init(from parser: ObjectParser) throws {","        self.date = try parser.scan(.date)","        self.attendees = try parser.scan(.number)","    }","","    static var orderingStrategy: OrderingStrategy { .unordered }","}","","\/\/ Both of these work:","let m1: Meeting = try \"March 15 with 5 people\".parseObject()","let m2: Meeting = try \"5 people on March 15\".parseObject()"],"type":"codeListing"},{"anchor":"Keywords","type":"heading","level":2,"text":"Keywords"},{"inlineContent":[{"type":"text","text":"To parse custom enum types from strings, conform them to "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/Keyword","isActive":true},{"type":"text","text":" and declare them as keyword types when creating the parser. Keywords are matched case-insensitively:"}],"type":"paragraph"},{"syntax":"swift","code":["enum BreakfastItem: String, Keyword {","    case waffles","    case eggs","","    var aliases: [String] {","        switch self {","        case .waffles: return [\"waffle\"]","        case .eggs: return [\"egg\"]","        }","    }","}","","struct BreakfastOrder: ParsableObject {","    let quantity: Int","    let item: BreakfastItem","","    init(from parser: ObjectParser) throws {","        self.quantity = try parser.scan(.number)","        self.item = try parser.scanKeyword(ofType: BreakfastItem.self)","    }","","    static var keywordTypes: KeywordTypeList { [BreakfastItem.self] }","}","","let order: BreakfastOrder = try \"2 waffles\".parseObject()"],"type":"codeListing"},{"name":"Important","style":"important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keyword types must be declared in "},{"isActive":true,"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ParsableObject\/keywordTypes"},{"type":"text","text":" (or passed to the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser"},{"type":"text","text":" initializer) so the parser can recognize them during tokenization."}]}]},{"type":"heading","level":2,"text":"Checking expression structure","anchor":"Checking-expression-structure"},{"type":"paragraph","inlineContent":[{"text":"You can inspect the expression before attempting a full parse:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let parser = ObjectParser(\"time in Sydney\")","","\/\/ Does this expression have the same structure as another?","parser.matchesStructure(of: \"time in Los Angeles\") \/\/ true","parser.matchesStructure(of: \"flights to London\")   \/\/ false","","\/\/ Are particular words present?","try parser.ensurePresent(words: [\"time\"]) \/\/ succeeds","","\/\/ Does the expression contain a particular token type?","parser.containsType(tokenType: .date)    \/\/ false","parser.containsType(tokenType: .place)   \/\/ true"]},{"type":"heading","level":2,"text":"Attempting multiple parses","anchor":"Attempting-multiple-parses"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser\/reset()","isActive":true,"type":"reference"},{"text":" to rewind the parser’s cursor and try parsing a different type from the same tokenized expression:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let parser = ObjectParser(\"QF 33 to London\", keywordTypes: [Airline.self, TravelDirection.self])","","if let flight: FlightLookup = try? parser.parse(FlightLookup.self) {","    \/\/ Got a full flight lookup","} else {","    parser.reset()","    if let route: RouteLookup = try? parser.parse(RouteLookup.self) {","        \/\/ Got a route lookup instead","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"This avoids re-tokenizing the string when you want to attempt multiple types against the same input.","type":"text"}]},{"type":"heading","level":2,"text":"Performing replacements","anchor":"Performing-replacements"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser","isActive":true,"type":"reference"},{"text":" can also generate new strings by replacing matched data types:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let parser = ObjectParser(\"I scored 85 and then 92\")","","\/\/ Replace the first number","let result = parser.replacingFirst(.number) { value in","    return \"\\(value + 10)\"","}","\/\/ \"I scored 95 and then 92\"","","\/\/ Replace all numbers","let result2 = parser.replacingAll(.number) { value in","    return \"\\(value + 10)\"","}","\/\/ \"I scored 95 and then 102\""]},{"type":"heading","level":2,"text":"Error handling","anchor":"Error-handling"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser","isActive":true,"type":"reference"},{"text":" throws ","type":"text"},{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser\/ScanningError","isActive":true,"type":"reference"},{"text":" values that include the type being parsed and the original expression, making debugging straightforward:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["do {","    let _: Flight = try \"not a flight\".parseObject()","} catch {","    print(error.localizedDescription)","    \/\/ \"Failed to parse Flight from expression: 'not a flight'\"","}"]}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/soulvercore\/objectparsing"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParsing"},"metadata":{"role":"article","title":"Objects from strings","modules":[{"name":"SoulverCore"}],"roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/app.soulver.core\/documentation\/SoulverCore"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","abstract":[{"text":"Transform natural language strings into strongly-typed Swift objects with a single call","type":"text"}],"seeAlsoSections":[{"title":"Data Parsing","generated":true,"anchor":"Data-Parsing","identifiers":["doc:\/\/app.soulver.core\/documentation\/SoulverCore\/DateParsing","doc:\/\/app.soulver.core\/documentation\/SoulverCore\/DataParsing"]}],"references":{"doc://app.soulver.core/documentation/SoulverCore/EngineCustomization":{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/EngineCustomization","title":"EngineCustomization","kind":"symbol","navigatorTitle":[{"text":"EngineCustomization","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"A key SoulverCore model object used to customize how you want SoulverCore to interpret expressions"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EngineCustomization","kind":"identifier"}],"url":"\/documentation\/soulvercore\/enginecustomization","role":"symbol"},"doc://app.soulver.core/documentation/SoulverCore/ObjectParser/ScanningError":{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser\/ScanningError","title":"ObjectParser.ScanningError","kind":"symbol","navigatorTitle":[{"text":"ScanningError","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Errors that can occur during scanning or parsing."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScanningError","kind":"