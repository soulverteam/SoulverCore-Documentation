{"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser"},{"text":" lets you parse a natural language string into a ready-to-use Swift object (or graph of objects) in a single call. It handles the tokenization, type recognition, and data extraction automatically.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Unlike the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/DataPoint"},{"type":"text","text":"-based "},{"type":"codeVoice","code":"find"},{"type":"text","text":" API (which extracts individual data points from strings), ObjectParser creates complete model objects — with all their properties populated from the data in the string."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The initializer form — conform to "},{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ParsableObject","type":"reference","isActive":true},{"type":"text","text":" and implement "},{"type":"codeVoice","code":"init(from parser: ObjectParser)"},{"type":"text","text":", scanning out the values you need — is inspired by Swift’s "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":"."}]},{"type":"heading","text":"Quick start","anchor":"Quick-start","level":2},{"type":"paragraph","inlineContent":[{"text":"The easiest way to parse objects is with the ","type":"text"},{"code":"parseObject()","type":"codeVoice"},{"text":" string extension, combined with types conforming to ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ParsableObject"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import SoulverCore","","struct SalesRecord: ParsableObject {","    let quantity: Int","    let date: Date","","    init(from parser: ObjectParser) throws {","        self.quantity = try parser.scan(.number)","        self.date = try parser.scan(.date)","    }","}","","let record: SalesRecord = try \"We sold 130 copies yesterday\".parseObject()","\/\/ record.quantity → 130","\/\/ record.date → yesterday's date"]},{"type":"heading","text":"Using ObjectParser directly","anchor":"Using-ObjectParser-directly","level":2},{"type":"paragraph","inlineContent":[{"text":"For more control, create an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser"},{"text":" instance yourself:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let parser = ObjectParser(\"QF 123 tomorrow\")","","let flight: Flight = try parser.parse(Flight.self)","let date: Date = try parser.scan(.date)"]},{"type":"paragraph","inlineContent":[{"text":"Creating the parser directly is useful when:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"You want to attempt multiple parses on the same tokenized string (using "},{"type":"reference","isActive":true,"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser\/reset()"},{"type":"text","text":" between attempts)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"You need to check the structure of the expression before parsing"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"You want to provide a custom "},{"type":"reference","isActive":true,"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/EngineCustomization"}],"type":"paragraph"}]}]},{"type":"heading","text":"Scanning data points","anchor":"Scanning-data-points","level":2},{"type":"paragraph","inlineContent":[{"text":"Inside a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ParsableObject"},{"text":" initializer, you use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser\/scan(_:)"},{"text":" and ","type":"text"},{"code":"scanIfPresent","type":"codeVoice"},{"text":" to extract individual data points from the expression:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct Pace: ParsableObject {","    let distanceTravelled: Decimal","    let time: TimeInterval","","    init(from parser: ObjectParser) throws {","        self.time = try parser.scan(.timespan).timeIntervalValue","        self.distanceTravelled = try parser.scan(.number)","    }","","    static var orderingStrategy: OrderingStrategy { .unordered }","}","","let pace: Pace = try \"I ran 3 km in 12.5 minutes\".parseObject()","\/\/ pace.distanceTravelled → 3","\/\/ pace.time → 750.0 (seconds)"]},{"type":"paragraph","inlineContent":[{"code":"scan","type":"codeVoice"},{"text":" throws if the data type isn’t found. ","type":"text"},{"code":"scanIfPresent","type":"codeVoice"},{"text":" returns nil instead.","type":"text"}]},{"type":"heading","text":"Nested objects","anchor":"Nested-objects","level":2},{"type":"paragraph","inlineContent":[{"code":"parse","type":"codeVoice"},{"text":" also handles nested ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ParsableObject"},{"text":" types, making object composition straightforward:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct FlightOnDate: ParsableObject {","    let flight: Flight","    let date: Date","","    init(from parser: ObjectParser) throws {","        self.flight = try parser.parse(Flight.self)","        self.date = try parser.scan(.date)","    }","}","","let query: FlightOnDate = try \"QF123 tomorrow\".parseObject()"]},{"type":"heading","text":"Ordered vs unordered parsing","anchor":"Ordered-vs-unordered-parsing","level":2},{"type":"paragraph","inlineContent":[{"text":"By default, properties are scanned in declaration order (the parser cursor advances forward through the string). Set ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/OrderingStrategy\/unordered"},{"text":" to allow properties to appear in any order:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct Meeting: ParsableObject {","    let date: Date","    let attendees: Int","","    init(from parser: ObjectParser) throws {","        self.date = try parser.scan(.date)","        self.attendees = try parser.scan(.number)","    }","","    static var orderingStrategy: OrderingStrategy { .unordered }","}","","\/\/ Both of these work:","let m1: Meeting = try \"March 15 with 5 people\".parseObject()","let m2: Meeting = try \"5 people on March 15\".parseObject()"]},{"type":"heading","text":"Keywords","anchor":"Keywords","level":2},{"type":"paragraph","inlineContent":[{"text":"To parse custom enum types from strings, conform them to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/Keyword"},{"text":" and declare them as keyword types when creating the parser. Keywords are matched case-insensitively:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["enum BreakfastItem: String, Keyword {","    case waffles","    case eggs","","    var aliases: [String] {","        switch self {","        case .waffles: return [\"waffle\"]","        case .eggs: return [\"egg\"]","        }","    }","}","","struct BreakfastOrder: ParsableObject {","    let quantity: Int","    let item: BreakfastItem","","    init(from parser: ObjectParser) throws {","        self.quantity = try parser.scan(.number)","        self.item = try parser.scanKeyword(ofType: BreakfastItem.self)","    }","","    static var keywordTypes: KeywordTypeList { [BreakfastItem.self] }","}","","let order: BreakfastOrder = try \"2 waffles\".parseObject()"]},{"content":[{"inlineContent":[{"type":"text","text":"Keyword types must be declared in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ParsableObject\/keywordTypes"},{"type":"text","text":" (or passed to the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser"},{"type":"text","text":" initializer) so the parser can recognize them during tokenization."}],"type":"paragraph"}],"type":"aside","name":"Important","style":"important"},{"type":"heading","text":"Checking expression structure","anchor":"Checking-expression-structure","level":2},{"type":"paragraph","inlineContent":[{"text":"You can inspect the expression before attempting a full parse:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let parser = ObjectParser(\"time in Sydney\")","","\/\/ Does this expression have the same structure as another?","parser.matchesStructure(of: \"time in Los Angeles\") \/\/ true","parser.matchesStructure(of: \"flights to London\")   \/\/ false","","\/\/ Are particular words present?","try parser.ensurePresent(words: [\"time\"]) \/\/ succeeds","","\/\/ Does the expression contain a particular token type?","parser.containsType(tokenType: .date)    \/\/ false","parser.containsType(tokenType: .place)   \/\/ true"]},{"type":"heading","text":"Attempting multiple parses","anchor":"Attempting-multiple-parses","level":2},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser\/reset()"},{"text":" to rewind the parser’s cursor and try parsing a different type from the same tokenized expression:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let parser = ObjectParser(\"QF 33 to London\", keywordTypes: [Airline.self, TravelDirection.self])","","if let flight: FlightLookup = try? parser.parse(FlightLookup.self) {","    \/\/ Got a full flight lookup","} else {","    parser.reset()","    if let route: RouteLookup = try? parser.parse(RouteLookup.self) {","        \/\/ Got a route lookup instead","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"This avoids re-tokenizing the string when you want to attempt multiple types against the same input.","type":"text"}]},{"type":"heading","text":"Performing replacements","anchor":"Performing-replacements","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser"},{"text":" can also generate new strings by replacing matched data types:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let parser = ObjectParser(\"I scored 85 and then 92\")","","\/\/ Replace the first number","let result = parser.replacingFirst(.number) { value in","    return \"\\(value + 10)\"","}","\/\/ \"I scored 95 and then 92\"","","\/\/ Replace all numbers","let result2 = parser.replacingAll(.number) { value in","    return \"\\(value + 10)\"","}","\/\/ \"I scored 95 and then 102\""]},{"type":"heading","text":"Error handling","anchor":"Error-handling","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser"},{"text":" throws ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser\/ScanningError"},{"text":" values that include the type being parsed and the original expression, making debugging straightforward:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["do {","    let _: Flight = try \"not a flight\".parseObject()","} catch {","    print(error.localizedDescription)","    \/\/ \"Failed to parse Flight from expression: 'not a flight'\"","}"]}],"kind":"content"}],"hierarchy":{"paths":