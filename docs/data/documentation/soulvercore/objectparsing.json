word types that you use in this object.","type":"text"}],"title":"keywordTypes","required":true,"role":"symbol","kind":"symbol","url":"\/documentation\/soulvercore\/parsableobject\/keywordtypes","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"keywordTypes","kind":"identifier"},{"text":": ","kind":"text"},{"text":"KeywordTypeList","kind":"typeIdentifier","preciseIdentifier":"s:11SoulverCore15KeywordTypeLista"}]}}}