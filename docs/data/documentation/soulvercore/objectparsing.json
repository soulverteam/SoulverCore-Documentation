e a phrase) you want to extract from the string"}],"type":"topic","navigatorTitle":[{"text":"Keyword","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Keyword","kind":"identifier"}],"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/Keyword"},"doc://app.soulver.core/documentation/SoulverCore/ParsableObject":{"kind":"symbol","url":"\/documentation\/soulvercore\/parsableobject","role":"symbol","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ParsableObject","abstract":[{"type":"text","text":"Adopt by an object that can be initialized from a string representation"}],"type":"topic","navigatorTitle":[{"text":"ParsableObject","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ParsableObject","kind":"identifier"}],"title":"ParsableObject"},"doc://app.soulver.core/documentation/SoulverCore/ObjectParser/reset()":{"kind":"symbol","type":"topic","url":"\/documentation\/soulvercore\/objectparser\/reset()","role":"symbol","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParser\/reset()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reset"},{"kind":"text","text":"()"}],"abstract":[{"type":"text","text":"Resets the parser to the beginning of the expression."}],"title":"reset()"},"doc://app.soulver.core/documentation/SoulverCore/DataPoint":{"navigatorTitle":[{"text":"DataPoint","kind":"identifier"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/DataPoint","abstract":[{"type":"text","text":"Wraps a parser for this particular data type"}],"url":"\/documentation\/soulvercore\/datapoint","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DataPoint","kind":"identifier"}],"title":"DataPoint"},"doc://app.soulver.core/documentation/SoulverCore/O