{"kind":"article","sections":[],"hierarchy":{"paths":[["doc:\/\/app.soulver.core\/documentation\/SoulverCore"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To calculate the result of a single expression, use a "},{"isActive":true,"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/Calculator","type":"reference"},{"type":"text","text":" object:"}]},{"syntax":"swift","code":["import SoulverCore","","let calculator = Calculator(customization: .standard)","let result = calculator.calculate(\"123 + 456\")","print(\"The answer is \\(result.stringValue)\") \/\/ prints 579"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"SoulverCore can perform all sorts of calculations, including unit conversions, date & calendar math, rate calculations, percentage phrase functions, time zone conversions, and much more. It also cleverly ignores “meaningless” words:"}],"type":"paragraph"},{"syntax":"swift","code":["calculator.calculate(\"$10 for lunch + 15% tip\") \/\/ $11.50","calculator.calculate(\"65 kg in pounds\") \/\/ 143.3 lb","calculator.calculate(\"40 as % of 90\") \/\/ 44.44%","calculator.calculate(\"$150 is 25% on what\") \/\/ $120","calculator.calculate(\"$25\/hour * 14 hours of work\") \/\/ $350.00","calculator.calculate(\"January 30 2020 + 3 months 2 weeks 5 days\") \/\/ May 19, 2020","calculator.calculate(\"9:35am in New York to Japan\") \/\/ 10:35 pm","calculator.calculate(\"$25k over 10 years at 7.5%\") \/\/ $51,525.79 (compound interest)"],"type":"codeListing"},{"anchor":"Variables","type":"heading","level":2,"text":"Variables"},{"inlineContent":[{"type":"text","text":"Use a "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/VariableList","isActive":true},{"type":"text","text":" to set values for words or phrases in your expression:"}],"type":"paragraph"},{"syntax":"swift","code":["let variableList = VariableList(variables:","    [","        Variable(name: \"a\", value: \"123\"),","        Variable(name: \"b\", value: \"456\"),","    ]",")","calculator.calculate(\"a + b\", with: variableList) \/\/ 579        "],"type":"codeListing"},{"anchor":"Locale-Settings","type":"heading","level":2,"text":"Locale Settings"},{"inlineContent":[{"type":"text","text":"SoulverCore respects the decimal separator and thousands separator of the system locale. Alternatively, you can convert the standard EngineCustomization to another locale:"}],"type":"paragraph"},{"syntax":"swift","code":["let europeanLocale = Locale(identifier: \"en_DE\")","let localizedCustomization = EngineCustomization.standard.convertTo(locale: europeanLocale)","","let calculator = Calculator(customization: localizedCustomization)",""," \/\/\/ In Germany a comma is used as a decimal separator","calculator.calculate(\"1,2 + 3,4\") \/\/ 4,6"],"type":"codeListing"},{"anchor":"Output-Formatting","type":"heading","level":2,"text":"Output Formatting"},{"inlineContent":[{"type":"text","text":"Use a "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/FormattingPreferences","isActive":true},{"type":"text","text":" to customize the way your result is formatted (how many decimal places to include, should the thousands separator be inserted, etc)."}],"type":"paragraph"},{"syntax":"swift","code":["var formattingPreferences = FormattingPreferences()","formattingPreferences.dp = 2 \/\/ decimal places","calculator.formattingPreferences = formattingPreferences","","calculator.calculate(\"π\") \/\/ 3.14"],"type":"codeListing"},{"anchor":"Live-Real-World--Crypto-Currency-Rates","type":"heading","level":2,"text":"Live Real-World & Crypto-Currency Rates"},{"inlineContent":[{"type":"text","text":"A standard "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/EngineCustomization","isActive":true},{"type":"text","text":" uses hard-coded rates for 190 real-world & crypto-currencies. You can (and should) provide SoulverCore with up-to-date rates by setting the "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/EngineCustomization\/currencyRateProvider","isActive":true},{"type":"text","text":" on your "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/EngineCustomization","isActive":true},{"type":"text","text":" to an object that conforms to "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/CurrencyRateProvider","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"SoulverCore includes one "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/CurrencyRateProvider","isActive":true},{"type":"text","text":" you can use to fetch rates from the "},{"type":"reference","identifier":"https:\/\/www.ecb.europa.eu\/stats\/eurofxref\/","isActive":true},{"type":"text","text":" for 33 popular fiat currencies."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/\/ This is a currency rate provider that fetches 33 popular fiat currencies from the European Central Bank, no API key required","let ecbCurrencyRateProvider = ECBCurrencyRateProvider()","","\/\/\/ Create a customization with this rate provider","var customizationWithLiveCurrencyRates = EngineCustomization.standard","customizationWithLiveCurrencyRates.currencyRateProvider = ecbCurrencyRateProvider","","\/\/\/ Create a calculator that uses this customization","let calculator = Calculator(customization: customizationWithLiveCurrencyRates)","","\/\/\/ Update to the latest rates...","ecbCurrencyRateProvider.updateRates { success in","    if success {","        \/\/ The standard customization will now have access to the latest currency rates","        let result = calculator.calculate(\"10 USD in EUR\")","        print(result.stringValue)","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"You can create your own object that conforms to "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/CurrencyRateProvider","isActive":true},{"type":"text","text":" to provide rates for the currency codes you support. The "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/CurrencyRateProvider","isActive":true},{"type":"text","text":" protocol has a single method that returns the amount of a given currency that 1.0 USD can buy:"}],"type":"paragraph"},{"syntax":"swift","code":["func rateFor(request: CurrencyRateRequest) -> Decimal? {","","    let currencyCode = request.currencyCode \/\/ EUR, GBP, BTC, etc","","    \/\/\/ - Return an up-to-date rate in the form of how much 1 USD can purchase of the requested currency (i.e 1 USD = x EUR?)","    \/\/\/ - If your rates are in terms of how much USD the requested currency can purchase (i.e 1 EUR = x USD?), remember to take the inverse by dividing 1 by your rate","            ","    return <# Currency Rate #>","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Rates are only requested from a "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/CurrencyRateProvider","isActive":true},{"type":"text","text":" at evaluation-time, so you don’t need to recreate or "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/Calculator","isActive":true},{"type":"text","text":" with a new "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/EngineCustomization","isActive":true},{"type":"text","text":" when your currency rate data source is updated. However you must reevaluate your line or expression: the latest rates for any currencies used will be fetched from your provider, if necessary."}],"type":"paragraph"},{"anchor":"Custom-Units","type":"heading","level":2,"text":"Custom Units"},{"inlineContent":[{"type":"text","text":"You can add custom units to an "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/EngineCustomization","isActive":true},{"type":"text","text":" object required by the initializer on "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/Calculator","isActive":true}],"type":"paragraph"},{"syntax":"swift","code":["\/\/\/ A good omakase EngineCustomization (the same used by Soulver.app)","var customization: EngineCustomization = .standard","","\/\/\/ Set an array of custom units defined in terms of an existing unit in SoulverCore","customization.customUnits = [","    CustomUnit(name: \"parrots\", definition: 15, equivalentUnit: .centimeters),","    CustomUnit(name: \"python\", definition: 570, equivalentUnit: .centimeters)","]","","\/\/\/ Create a Calculator using this customization","let calculator = Calculator(customization: customization)","","\/\/\/ python and parrots are now recognized as units","calculator.calculate(\"1 python in parrots\") \/\/ 38 parrots"],"type":"codeListing"},{"anchor":"Custom-Functions","type":"heading","level":2,"text":"Custom Functions"},{"inlineContent":[{"type":"text","text":"The syntax of a function in SoulverCore is flexible. We support traditional C-style “func(x)” functions, Swift-style “calculate(withParameter: x)” functions, or even natural phrases like “calculate x”."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can add custom functions objects to the "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/EngineCustomization","isActive":true},{"type":"text","text":" required by the initializer on "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/Calculator","isActive":true},{"type":"text","text":". Here is an example of a custom function that takes 1 off a given number:"}],"type":"paragraph"},{"syntax":"swift","code":["","\/\/\/ Get the default Engine Customization","var customization: EngineCustomization = .standard","","\/\/\/ A prototype expression is an example of what the user will type to invoke your function","\/\/\/ The following function will trigger for any phrase with the form 'number before x', where x is some number","","customization.customFunctions = [CustomFunction(prototypeExpression: \"number before 9\", handler: { parameters in","    ","    guard let parameterDecimalValue = parameters[0].decimalValue else {","        return EvaluationResult.none","    }","    ","    return .decimal(parameterDecimalValue - 1.0)","    ","})]","","let calculator = Calculator(customization: customization)","let result = calculator.calculate(\"number before 35\")","","print(result.stringValue) \/\/ prints '34'"],"type":"codeListing"},{"anchor":"Localizations","type":"heading","level":2,"text":"Localizations"},{"inlineContent":[{"type":"text","text":"In addition to English, SoulverCore is fully localized into German, Russian, French, Spanish & simplified Chinese."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The various number & date formats of these various locales are also fully supported."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Also note that non-English languages are "},{"type":"emphasis","inlineContent":[{"type":"text","text":"additive"}]},{"type":"text","text":", meaning that, for instance, a German user would be able to use both English & German syntaxes."}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/GettingStarted"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/soulvercore\/gettingstarted"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/soulvercore\/gettingstarted"]}],"metadata":{"title":"Getting Started with SoulverCore","role":"article","roleHeading":"Article","modules":[{"name":"SoulverCore"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Create a calculator and customize calculation & result formatting"}],"references":{"doc://app.soulver.core/documentation/SoulverCore/EngineCustomization/currencyRateProvider":{"kind":"symbol","type":"topic","url":"\/documentation\/soulvercore\/enginecustomization\/currencyrateprovider","role":"symbol","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/EngineCustomization\/currencyRateProvider","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"currencyRateProvider","kind":"identifier"},{"text":": ","kind":"text"},{"text":"CurrencyRateProvider","kind":"typeIdentifier","preciseIdentifier":"s:11SoulverCore20CurrencyRateProviderP"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"Provide an object that conforms to "},{"type":"codeVoice","code":"CurrencyRateProvider"},{"type":"text","text":" to enable live currency rates in calculations"}],"title":"currencyRateProvider"},"https://www.ecb.europa.eu/stats/eurofxref/":{"type":"link","title":"European Central Bank","identifier":"https:\/\/www.ecb.europa.eu\/stats\/eurofxref\/","titleInlineContent":[{"type":"text","text":"European Central Bank"}],"url":"https:\/\/www.ecb.europa.eu\/stats\/eurofxref\/"},"doc://app.soulver.core/documentation/SoulverCore/FormattingPreferences":{"role":"symbol","title":"FormattingPreferences","url":"\/documentation\/soulvercore\/formattingpreferences","abstract":[{"type":"text","text":"A configuration object used to specify how you want SoulverCore to format results"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"FormattingPreferences"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FormattingPreferences"}],"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/FormattingPreferences"},"doc://app.soulver.core/documentation/SoulverCore/EngineCustomization":{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/EngineCustomization","title":"EngineCustomization","kind":"symbol","navigatorTitle":[{"text":"EngineCustomization","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"A key SoulverCore model object used to customize how you want SoulverCore to interpret expressions"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EngineCustomization","kind":"identifier"}],"url":"\/documentation\/soulvercore\/enginecustomization","role":"symbol"},"doc://app.soulver.core/documentation/SoulverCore/CurrencyRateProvider":{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/CurrencyRateProvider","kind":"symbol","title":"CurrencyRateProvider","navigatorTitle":[{"kind":"identifier","text":"CurrencyRateProvider"}],"type":"topic","abstract":[{"type":"text","text":"CurrencyRateProvider is an object that provides currency rates to be used in unit calculations"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CurrencyRateProvider"}],"url":"\/documentation\/soulvercore\/currencyrateprovider","role":"symbol"},"doc://app.soulver.core/documentation/SoulverCore/VariableList":{"navigatorTitle":[{"text":"VariableList","kind":"identifier"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/VariableList","url":"\/documentation\/soulvercore\/variablelist","abstract":[{"type":"text","text":"A list of variables (single words or phrases) and their values"}],"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"VariableList","kind":"identifier"}],"title":"VariableList"},"doc://app.soulver.core/documentation/SoulverCore":{"role":"collection","url":"\/documentation\/soulvercore","title":"SoulverCore","abstract":[{"type":"text","text":"A powerful natural language calculation engine"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore"},"doc://app.soulver.core/documentation/SoulverCore/Calculator":{"kind":"symbol","url":"\/documentation\/soulvercore\/calculator","role":"symbol","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/Calculator","abstract":[{"text":"Evaluate natural language mathematical expressions","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Calculator"}],"fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Calculator"}],"title":"Calculator"}},"variantOverrides":[{"traits":[{"interfaceLanguage":"occ"}],"patch":[{"value":"occ","op":"replace","path":"\/identifier\/interfaceLanguage"},{"value":null,"op":"add","path":"\/topicSections"},{"value":null,"op":"add","path":"\/seeAlsoSections"}]}]}