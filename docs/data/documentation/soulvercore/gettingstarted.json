{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/GettingStarted"},"abstract":[{"text":"Create a calculator and customize calculation & result formatting","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/soulvercore\/gettingstarted"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/soulvercore\/gettingstarted"]}],"metadata":{"role":"article","roleHeading":"Article","title":"Getting Started with SoulverCore","modules":[{"name":"SoulverCore"}]},"hierarchy":{"paths":[["doc:\/\/app.soulver.core\/documentation\/SoulverCore"]]},"sections":[],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"To calculate the result of a single expression, use a ","type":"text"},{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/Calculator","isActive":true,"type":"reference"},{"text":" object:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SoulverCore","","let calculator = Calculator(customization: .standard)","let result = calculator.calculate(\"123 + 456\")","print(\"The answer is \\(result.stringValue)\") \/\/ prints 579"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"SoulverCore can perform all sorts of calculations, including unit conversions, date & calendar math, rate calculations, percentage phrase functions, time zone conversions, and much more. It also cleverly ignores “meaningless” words:"}]},{"syntax":"swift","type":"codeListing","code":["calculator.calculate(\"$10 for lunch + 15% tip\") \/\/ $11.50","calculator.calculate(\"65 kg in pounds\") \/\/ 143.3 lb","calculator.calculate(\"40 as % of 90\") \/\/ 44.44%","calculator.calculate(\"$150 is 25% on what\") \/\/ $120","calculator.calculate(\"$25\/hour * 14 hours of work\") \/\/ $350.00","calculator.calculate(\"January 30 2020 + 3 months 2 weeks 5 days\") \/\/ May 19, 2020","calculator.calculate(\"9:35am in New York to Japan\") \/\/ 10:35 pm","calculator.calculate(\"$25k over 10 years at 7.5%\") \/\/ $51,525.79 (compound interest)"]},{"anchor":"Variables","text":"Variables","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Use a ","type":"text"},{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/VariableList","type":"reference","isActive":true},{"type":"text","text":" to set values for words or phrases in your expression:"}]},{"type":"codeListing","code":["let variableList = VariableList(variables:","    [","        Variable(name: \"a\", value: \"123\"),","        Variable(name: \"b\", value: \"456\"),","    ]",")","calculator.calculate(\"a + b\", with: variableList) \/\/ 579        "],"syntax":"swift"},{"anchor":"Locale-Settings","text":"Locale Settings","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"SoulverCore respects the decimal separator and thousands separator of the system locale. Alternatively, you can convert the standard EngineCustomization to another locale:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let europeanLocale = Locale(identifier: \"en_DE\")","let localizedCustomization = EngineCustomization.standard.convertTo(locale: europeanLocale)","","let calculator = Calculator(customization: localizedCustomization)",""," \/\/\/ In Germany a comma is used as a decimal separator","calculator.calculate(\"1,2 + 3,4\") \/\/ 4,6"]},{"anchor":"Output-Formatting","text":"Output Formatting","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/FormattingPreferences"},{"type":"text","text":" to customize the way your result is formatted (how many decimal places to include, should the thousands separator be inserted, etc)."}]},{"syntax":"swift","type":"codeListing","code":["var formattingPreferences = FormattingPreferences()","formattingPreferences.dp = 2 \/\/ decimal places","calculator.formattingPreferences = formattingPreferences","","calculator.calculate(\"π\") \/\/ 3.14"]},{"anchor":"Live-Real-World--Crypto-Currency-Rates","level":2,"text":"Live Real-World & Crypto-Currency Rates","type":"heading"},{"inlineContent":[{"text":"A standard ","type":"text"},{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/EngineCustomization","isActive":true,"type":"reference"},{"text":" uses hard-coded rates for 190 real-world & crypto-currencies. You can (and should) provide SoulverCore with up-to-date rates by setting the ","type":"text"},{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/EngineCustomization\/currencyRateProvider","isActive":true,"type":"reference"},{"text":" on your ","type":"text"},{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/EngineCustomization","isActive":true,"type":"reference"},{"text":" to an object that conforms to ","type":"text"},{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/CurrencyRateProvider","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"SoulverCore includes one ","type":"text"},{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/CurrencyRateProvider","isActive":true,"type":"reference"},{"text":" you can use to fetch rates from the ","type":"text"},{"identifier":"https:\/\/www.ecb.europa.eu\/stats\/eurofxref\/","isActive":true,"type":"reference"},{"text":" for 33 popular fiat currencies.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/\/ This is a currency rate provider that fetches 33 popular fiat currencies from the European Central Bank, no API key required","let ecbCurrencyRateProvider = ECBCurrencyRateProvider()","","\/\/\/ Create a customization with this rate provider","var customizationWithLiveCurrencyRates = EngineCustomization.standard","customizationWithLiveCurrencyRates.currencyRateProvider = ecbCurrencyRateProvider","","\/\/\/ Create a calculator that uses this customization","let calculator = Calculator(customization: customizationWithLiveCurrencyRates)","","\/\/\/ Update to the latest rates...","ecbCurrencyRateProvider.updateRates { success in","    if success {","        \/\/ The standard customization will now have access to the latest currency rates","        let result = calculator.calculate(\"10 USD in EUR\")","        print(result.stringValue)","    }","}"]},{"inlineContent":[{"text":"You can create your own object that conforms to ","type":"text"},{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/CurrencyRateProvider","isActive":true,"type":"reference"},{"text":" to provide rates for the currency codes you support. The ","type":"text"},{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/CurrencyRateProvider","isActive":true,"type":"reference"},{"text":" protocol has a single method that returns the amount of a given currency that 1.0 USD can buy:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func rateFor(request: CurrencyRateRequest) -> Decimal? {","","    let currencyCode = request.currencyCode \/\/ EUR, GBP, BTC, etc","","    \/\/\/ - Return an up-to-date rate in the form of how much 1 USD can purchase of the requested currency (i.e 1 USD = x EUR?)","    \/\/\/ - If your rates are in terms of how much USD the requested currency can purchase (i.e 1 EUR = x USD?), remember to take the inverse by dividing 1 by your rate","            ","    return <# Currency Rate #>","}"]},{"inlineContent":[{"text":"Rates are only requested from a ","type":"text"},{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/CurrencyRateProvider","isActive":true,"type":"reference"},{"text":" at evaluation-time, so you don’t need to recreate or ","type":"text"},{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/Calculator","isActive":true,"type":"reference"},{"text":" with a new ","type":"text"},{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/EngineCustomization","isActive":true,"type":"reference"},{"text":" when your currency rate data source is updated. However you must reevaluate your line or expression: the latest rates for any currencies used will be fetched from your provider, if necessary.","type":"text"}],"type":"paragraph"},{"anchor":"Custom-Units","level":2,"text":"Custom Units","type":"heading"},{"inlineContent":[{"text":"You can add custom units to an ","type":"text"},{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/EngineCustomization","isActive":true,"type":"reference"},{"text":" object required by the initializer on ","type":"text"},{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/Calculator","isActive":true,"type":"reference"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/\/ A good omakase EngineCustomization (the same used by Soulver.app)","var customization: EngineCustomization = .standard","","\/\/\/ Set an array of custom units defined in terms of an existing unit in SoulverCore","customization.customUnits = [","    CustomUnit(name: \"parrots\", definition: 15, equivalentUnit: .centimeters),","    CustomUnit(name: \"python\", definition: 570, equivalentUnit: .centimeters)","]","","\/\/\/ Create a Calculator using this customization","let calculator = Calculator(customization: customization)","","\/\/\/ python and parrots are now recognized as units","calculator.calculate(\"1 python in parrots\") \/\/ 38 parrots"]},{"anchor":"Custom-Functions","level":2,"text":"Custom Functions","type":"heading"},{"inlineContent":[{"text":"The syntax of a function in SoulverCore is flexible. We support traditional C-style “func(x)” functions, Swift-style “calculate(withParameter: x)” functions, or even natural phrases like “calculate x”.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You can add custom functions objects to the ","type":"text"},{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/EngineCustomization","isActive":true,"type":"reference"},{"text":" required by the initializer on ","type":"text"},{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/Calculator","isActive":true,"type":"reference"},{"text":". Here is an example of a custom function that takes 1 off a given number:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["","\/\/\/ Get the default Engine Customization","var customization: EngineCustomization = .standard","","\/\/\/ A prototype expression is an example of what the user will type to invoke your function","\/\/\/ The following function will trigger for any phrase with the form 'number before x', where x is some number","","customization.customFunctions = [CustomFunction(prototypeExpression: \"number before 9\", handler: { parameters in","    ","    guard let parameterDecimalValue = parameters[0].decimalValue else {","        return EvaluationResult.none","    }","    ","    return .decimal(parameterDecimalValue - 1.0)","    ","})]","","let calculator = Calculator(customization: customization)","let result = calculator.calculate(\"number before 35\")","","print(result.stringValue) \/\/ prints '34'"]},{"anchor":"Localizations","level":2,"text":"Localizations","type":"heading"},{"inlineContent":[{"text":"In addition to English, SoulverCore is fully localized into German, Russian, French, Spanish & simplified Chinese.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The various number & date formats of these various locales are also fully supported.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Also note that non-English languages are ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"additive"}]},{"text":", meaning that, for instance, a German user would be able to use both English & German syntaxes.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://app.soulver.core/documentation/SoulverCore/FormattingPreferences":{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/FormattingPreferences","url":"\/documentation\/soulvercore\/formattingpreferences","kind":"symbol","abstract":[{"text":"A configuration object used to specify how you want SoulverCore to format results","type":"text"}],"type":"topic","title":"FormattingPreferences","role":"symbol","navigatorTitle":[{"text":"FormattingPreferences","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FormattingPreferences","kind":"identifier"}]},"doc://app.soulver.core/documentation/SoulverCore/VariableList":{"role":"symbol","abstract":[{"text":"A list of variables (single words or phrases) and their values","type":"text"}],"kind":"symbol","title":"VariableList","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/VariableList","type":"topic","url":"\/documentation\/soulvercore\/variablelist","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VariableList","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"VariableList"}]},"doc://app.soulver.core/documentation/SoulverCore/EngineCustomization/currencyRateProvider":{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/EngineCustomization\/currencyRateProvider","url":"\/documentation\/soulvercore\/enginecustomization\/currencyrateprovider","kind":"symbol","abstract":[{"type":"text","text":"Provide an object that conforms to "},{"type":"codeVoice","code":"CurrencyRateProvider"},{"type":"text","text":" to enable live currency rates in calculations"}],"type":"topic","title":"currencyRateProvider","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"currencyRateProvider","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"CurrencyRateProvider","preciseIdentifier":"s:11SoulverCore20CurrencyRateProviderP"},{"kind":"text","text":"?"}]},"doc://app.soulver.core/documentation/SoulverCore/Calculator":{"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/Calculator","type":"topic","kind":"symbol","abstract":[{"text":"Evaluate natural language mathematical expressions","type":"text"}],"url":"\/documentation\/soulvercore\/calculator","title":"Calculator","role":"symbol","navigatorTitle":[{"text":"Calculator","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"Calculator","kind":"identifier"}]},"doc://app.soulver.core/documentation/SoulverCore/EngineCustomization":{"title":"EngineCustomization","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/EngineCustomization","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EngineCustomization","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"EngineCustomization"}],"abstract":[{"text":"A key SoulverCore model object used to customize how you want SoulverCore to interpret expressions","type":"text"}],"url":"\/documentation\/soulvercore\/enginecustomization","role":"symbol"},"doc://app.soulver.core/documentation/SoulverCore/CurrencyRateProvider":{"abstract":[{"text":"CurrencyRateProvider is an object that provides currency rates to be used in unit calculations","type":"text"}],"kind":"symbol","type":"topic","title":"CurrencyRateProvider","navigatorTitle":[{"kind":"identifier","text":"CurrencyRateProvider"}],"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CurrencyRateProvider"}],"identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/CurrencyRateProvider","url":"\/documentation\/soulvercore\/currencyrateprovider"},"https://www.ecb.europa.eu/stats/eurofxref/":{"identifier":"https:\/\/www.ecb.europa.eu\/stats\/eurofxref\/","titleInlineContent":[{"text":"European Central Bank","type":"text"}],"url":"https:\/\/www.ecb.europa.eu\/stats\/eurofxref\/","type":"link","title":"European Central Bank"},"doc://app.soulver.core/documentation/SoulverCore":{"kind":"symbol","title":"SoulverCore","url":"\/documentation\/soulvercore","role":"collection","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore","type":"topic","abstract":[{"type":"text","text":"A powerful natural language calculation engine"}]}},"variantOverrides":[{"traits":[{"interfaceLanguage":"occ"}],"patch":[{"path":"\/identifier\/interfaceLanguage","op":"replace","value":"occ"},{"path":"\/topicSections","op":"add","value":null},{"path":"\/seeAlsoSections","op":"add","value":null}]}]}