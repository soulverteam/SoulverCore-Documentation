{"kind":"article","hierarchy":{"paths":[["doc:\/\/app.soulver.core\/documentation\/SoulverCore"]]},"identifier":{"url":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/DateParsing","interfaceLanguage":"swift"},"abstract":[{"text":"Add a natural language date scheduling feature to your Mac or iOS calendar or reminders app","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"content":[{"type":"heading","anchor":"Motivation","text":"Motivation","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Natural language date input features can be found in apps like "},{"type":"reference","identifier":"https:\/\/culturedcode.com\/things\/support\/articles\/9780167\/","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"https:\/\/flexibits.com\/fantastical-ios\/help\/adding","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"https:\/\/www.raycast.com\/extensions\/reminders","isActive":true},{"type":"text","text":" and make the user experience better."}]},{"type":"heading","anchor":"Usage","level":2,"text":"Usage"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SoulverCore"},{"type":"text","text":" adds a single property "},{"type":"codeVoice","code":"dateValue"},{"type":"text","text":" to "},{"type":"codeVoice","code":"String"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["public extension String {","   var dateValue: Date?","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this property to extract the last natural language date found in the string. The "},{"type":"codeVoice","code":"dateValue"},{"type":"text","text":" will be "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if there are no dates in the string."}]},{"type":"heading","anchor":"SoulverCore-vs-Foundations-DataDetector","level":2,"text":"SoulverCore vs Foundation’s DataDetector"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apple’s Foundation framework includes NSDataDetector for detecting dates in strings."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here is an example:"}]},{"type":"codeListing","code":["let expression = \"March 5th, 2023\"","let types: NSTextCheckingResult.CheckingType = [.date ]","let detector = try! NSDataDetector(types: types.rawValue)","let match = detector.matches(in: expression, options: .init(rawValue: 0), range: NSRange(location: 0, length: expression.count)).first","let date = match?.date"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Compare this to SoulverCore:"}]},{"type":"codeListing","syntax":"swift","code":["let date = \"March 5th, 2023\".dateValue"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In addition to a much nicer API, SoulverCore also adds a number of additional features not supported by NSDataDetector."}]},{"level":2,"type":"heading","text":"Supported Features","anchor":"Supported-Features"},{"anchor":"Natural-language-calendar-math","type":"heading","text":"Natural language calendar math","level":4},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use natural language phrases like “3 weeks from tomorrow” and “march 12 + 4 weeks 3 days”."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"SoulverCore supports a large range of different natural language date syntaxes. See the "},{"type":"reference","identifier":"https:\/\/documentation.soulver.app\/syntax-reference\/dates-and-times","isActive":true},{"type":"text","text":" for more examples."}]},{"anchor":"Units--unit-shorthands","type":"heading","text":"Units & unit shorthands","level":4},{"type":"paragraph","inlineContent":[{"type":"text","text":"SoulverCore interprets units of time as referring to a future date after the specified amount of time has passed."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example "},{"type":"codeVoice","code":"2 weeks 2 days"},{"type":"text","text":" will be interpreted as "},{"type":"codeVoice","code":"2 weeks and 2 days"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"from now"}]},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following time unit shorthands are also supported:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"“1y” (1 year)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"“5mo” (5 months)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"“3w” (3 weeks)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"“2d” (2 days)"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Shorthands can be combined together:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"“12-9 9p” means the “12th of September at 9pm” (in a non-US locale)"}]}]}]},{"level":4,"text":"Half-formed dates","type":"heading","anchor":"Half-formed-dates"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Examples:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"“3\/12” (Dec 3, or March 12 in the US)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"“12.2” (Feb 12 or Dec 2 in the US)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"“9-5” (May 9 or Sep 5 in the US)","type":"text"}]}]}]},{"type":"heading","anchor":"Day--month-shorthands","level":4,"text":"Day & month shorthands"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Examples:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"“Next mon” (next monday)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"“tod” (today)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"“apr3” (April 3)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"“yes” (yesterday)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"“tom” (tomorrow)"}]}]}]},{"type":"heading","anchor":"AMPM-shorthands","level":4,"text":"AM\/PM shorthands"},{"type":"paragraph","inlineContent":[{"text":"Examples:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"“3p” (3pm)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"“5a” (5am)"}]}]}]},{"type":"heading","anchor":"Random-words-ignored","level":4,"text":"Random words ignored"},{"type":"paragraph","inlineContent":[{"type":"text","text":"SoulverCore extracts the last date present in the given string, and ignores random words before and after it."}]},{"type":"paragraph","inlineContent":[{"text":"For example, the following are valid inputs:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"“Tom’s birthday party "},{"type":"strong","inlineContent":[{"type":"text","text":"this sunday"}]},{"type":"text","text":"”"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"“Schedule the meeting for "},{"type":"strong","inlineContent":[{"type":"text","text":"April 21st next year"}]},{"type":"text","text":"”"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"“"},{"type":"strong","inlineContent":[{"type":"text","text":"June 5"}]},{"type":"text","text":" the kids get off school”"}]}]}]},{"level":2,"text":"Detailed information about the parsed date","type":"heading","anchor":"Detailed-information-about-the-parsed-date"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/Datestamp\/DatestampType","isActive":true},{"type":"text","text":" enum contains detailed information about the kind of date detected and what date components were explicitly specified."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here is how an example of how to get the formatting and components of the detected date:"}]},{"type":"codeListing","syntax":"swift","code":["var engineCustomization = EngineCustomization.standard","engineCustomization.featureFlags.seeksFutureDate = true","let calculator = Calculator(customization: engineCustomization)","","if let datestampType = calculator.dateFor(inputDateText)?.result.evaluationResult.datestampValue?.type {","    print(\"Date of type \\(datestampType)\")","}"]},{"level":2,"text":"Performance","type":"heading","anchor":"Performance"},{"type":"paragraph","inlineContent":[{"type":"text","text":"SoulverCore is very efficient and can perform thousands of date-from-string extractions every second."}]},{"level":2,"text":"Localizations","type":"heading","anchor":"Localizations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In addition to English, SoulverCore is localized into German, French, Spanish, Italian, Russian, Japanese, Korean & Simplified Chinese."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The user’s system locale will be used for date parsing, and date & time formats specific the particular region are taken into account."}]}],"kind":"content"}],"metadata":{"role":"article","title":"Dates from strings","modules":[{"name":"SoulverCore"}],"roleHeading":"Article"},"seeAlsoSections":[{"anchor":"Data-Parsing","identifiers":["doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParsing","doc:\/\/app.soulver.core\/documentation\/SoulverCore\/DataParsing"],"title":"Data Parsing","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/soulvercore\/dateparsing"]}],"sections":[],"references":{"https://flexibits.com/fantastical-ios/help/adding":{"titleInlineContent":[{"text":"Fantastical","