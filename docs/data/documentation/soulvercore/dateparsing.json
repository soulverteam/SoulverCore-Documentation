:"https:\/\/www.raycast.com\/extensions\/reminders"},"https://documentation.soulver.app/syntax-reference/dates-and-times":{"titleInlineContent":[{"text":"Soulver Documentation","type":"text"}],"identifier":"https:\/\/documentation.soulver.app\/syntax-reference\/dates-and-times","title":"Soulver Documentation","type":"link","url":"https:\/\/documentation.soulver.app\/syntax-reference\/dates-and-times"},"doc://app.soulver.core/documentation/SoulverCore/DataParsing":{"kind":"article","type":"topic","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/DataParsing","abstract":[{"text":"A declarative & type-safe approach to extracting various data types out of strings","type":"text"}],"url":"\/documentation\/soulvercore\/dataparsing","role":"article","title":"Data from strings"}}}