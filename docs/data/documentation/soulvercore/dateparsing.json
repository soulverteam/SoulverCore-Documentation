{"seeAlsoSections":[{"title":"Data Parsing","identifiers":["doc:\/\/app.soulver.core\/documentation\/SoulverCore\/ObjectParsing","doc:\/\/app.soulver.core\/documentation\/SoulverCore\/DataParsing"],"generated":true,"anchor":"Data-Parsing"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/soulvercore\/dateparsing"]}],"identifier":{"url":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/DateParsing","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Motivation","anchor":"Motivation"},{"type":"paragraph","inlineContent":[{"text":"Natural language date input features can be found in apps like ","type":"text"},{"isActive":true,"identifier":"https:\/\/culturedcode.com\/things\/support\/articles\/9780167\/","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"https:\/\/flexibits.com\/fantastical-ios\/help\/adding","type":"reference"},{"type":"text","text":" and "},{"isActive":true,"identifier":"https:\/\/www.raycast.com\/extensions\/reminders","type":"reference"},{"type":"text","text":" and make the user experience better."}]},{"type":"heading","level":2,"anchor":"Usage","text":"Usage"},{"inlineContent":[{"code":"SoulverCore","type":"codeVoice"},{"type":"text","text":" adds a single property "},{"code":"dateValue","type":"codeVoice"},{"type":"text","text":" to "},{"code":"String","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["public extension String {","   var dateValue: Date?","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Use this property to extract the last natural language date found in the string. The "},{"code":"dateValue","type":"codeVoice"},{"type":"text","text":" will be "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if there are no dates in the string."}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"SoulverCore-vs-Foundations-DataDetector","text":"SoulverCore vs Foundation’s DataDetector"},{"inlineContent":[{"type":"text","text":"Apple’s Foundation framework includes NSDataDetector for detecting dates in strings."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Here is an example:"}],"type":"paragraph"},{"code":["let expression = \"March 5th, 2023\"","let types: NSTextCheckingResult.CheckingType = [.date ]","let detector = try! NSDataDetector(types: types.rawValue)","let match = detector.matches(in: expression, options: .init(rawValue: 0), range: NSRange(location: 0, length: expression.count)).first","let date = match?.date"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Compare this to SoulverCore:"}],"type":"paragraph"},{"code":["let date = \"March 5th, 2023\".dateValue"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"In addition to a much nicer API, SoulverCore also adds a number of additional features not supported by NSDataDetector."}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Supported-Features","text":"Supported Features"},{"text":"Natural language calendar math","level":4,"type":"heading","anchor":"Natural-language-calendar-math"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use natural language phrases like “3 weeks from tomorrow” and “march 12 + 4 weeks 3 days”."}]},{"type":"paragraph","inlineContent":[{"text":"SoulverCore supports a large range of different natural language date syntaxes. See the ","type":"text"},{"identifier":"https:\/\/documentation.soulver.app\/syntax-reference\/dates-and-times","isActive":true,"type":"reference"},{"type":"text","text":" for more examples."}]},{"text":"Units & unit shorthands","level":4,"anchor":"Units--unit-shorthands","type":"heading"},{"inlineContent":[{"type":"text","text":"SoulverCore interprets units of time as referring to a future date after the specified amount of time has passed."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example "},{"type":"codeVoice","code":"2 weeks 2 days"},{"type":"text","text":" will be interpreted as "},{"type":"codeVoice","code":"2 weeks and 2 days"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"from now"}]},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following time unit shorthands are also supported:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"“1y” (1 year)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"“5mo” (5 months)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"“3w” (3 weeks)","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"“2d” (2 days)","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Shorthands can be combined together:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"“12-9 9p” means the “12th of September at 9pm” (in a non-US locale)"}],"type":"paragraph"}]}]},{"type":"heading","text":"Half-formed dates","anchor":"Half-formed-dates","level":4},{"type":"paragraph","inlineContent":[{"text":"Examples:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"“3\/12” (Dec 3, or March 12 in the US)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"“12.2” (Feb 12 or Dec 2 in the US)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"“9-5” (May 9 or Sep 5 in the US)"}],"type":"paragraph"}]}]},{"type":"heading","text":"Day & month shorthands","anchor":"Day--month-shorthands","level":4},{"type":"paragraph","inlineContent":[{"text":"Examples:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"“Next mon” (next monday)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"“tod” (today)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"“apr3” (April 3)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"“yes” (yesterday)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"“tom” (tomorrow)"}],"type":"paragraph"}]}]},{"type":"heading","text":"AM\/PM shorthands","anchor":"AMPM-shorthands","level":4},{"type":"paragraph","inlineContent":[{"text":"Examples:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"“3p” (3pm)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"“5a” (5am)"}],"type":"paragraph"}]}]},{"type":"heading","text":"Random words ignored","anchor":"Random-words-ignored","level":4},{"type":"paragraph","inlineContent":[{"text":"SoulverCore extracts the last date present in the given string, and ignores random words before and after it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, the following are valid inputs:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"“Tom’s birthday party "},{"type":"strong","inlineContent":[{"type":"text","text":"this sunday"}]},{"type":"text","text":"”"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"“Schedule the meeting for ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"April 21st next year"}]},{"text":"”","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"“"},{"type":"strong","inlineContent":[{"type":"text","text":"June 5"}]},{"type":"text","text":" the kids get off school”"}]}]}]},{"type":"heading","text":"Detailed information about the parsed date","anchor":"Detailed-information-about-the-parsed-date","level":2},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/app.soulver.core\/documentation\/SoulverCore\/Datestamp\/DatestampType"},{"text":" enum contains detailed information about the kind of date detected and what date components were explicitly specified.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Here is how an example of how to get the formatting and components of the detected date:","type":"text"}]},{"type":"codeListing","code":["var engineCustomization = EngineCustomization.standard","engineCustomization.featureFlags.seeksFutureDate = true","let calculator = Calculator(customization: engineCustomization)","","if let datestampType = calculator.dateFor(inputDateText)?.result.evaluationResult.datestampValue?.type {","    print(\"Date of type \\(datestampType)\")","}"],"syntax":"swift"},{"text":"Performance","level":2,"anchor":"Performance","type":"heading"},{"inlineContent":[{"type":"text","text":"SoulverCore is very efficient and can perform thousands of date-from-string extractions every second."}],"type":"paragraph"},{"text":"Localizations","level":2,"anchor":"Localizations","type":"heading"},{"inlineContent":[{"type":"text","text":"In addition to English, SoulverCore is localized into German, French, Spanish, Italian, Russian, Japanese, Korean & Simplified Chinese."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The user’s system locale will be used for date parsing, and date & time formats specific the particular region are taken into account."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/app.soulver.core\/documentation\/SoulverCore"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"modules":[{"name":"SoulverCore"}],"roleHeading":"Article","role":"article","title":"Dates from strings"},"abstract":[{"type":"text","text":"Add a natural language date scheduling feature to your Mac or iOS calendar or reminders app"}],"kind":"article","references":{"https://flexibits.com/fantastical-ios/help/adding":{"title":"Fantastical","identifier":"https:\/\